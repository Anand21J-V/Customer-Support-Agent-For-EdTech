# Gemini API
GEMINI_API_KEY=

GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=student_support
MYSQL_USER=student_ai
MYSQL_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=student_support_knowledge

# Retrieval
TOP_K_VECTOR=10
TOP_K_BM25=10
TOP_K_FINAL=5

# Local embeddings (Phase 2 - open source, no API key required)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
KNOWLEDGE_DOCX_PATH=knowledge-base/Student-Policy-knowledge-base.docx
BM25_CACHE_PATH=data/evaluation/bm25_corpus.json
INGEST_MANIFEST_PATH=data/evaluation/ingest_manifest.json

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=student-support-ai

# App
LOG_LEVEL=INFO
